---
import { withBase } from '../utils/urls';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="페이지를 찾을 수 없어요" simple>
  <section class="status-page section-light">
    <div class="container status-inner">
      <div class="error-number" aria-hidden="true">
        404<span>↗</span>
      </div>
      <h1>
        페이지를
        <br />
        찾을 수 없습니다.
      </h1>
      <p>
        페이지 주소가 바뀌었거나 존재하지 않습니다.
        <br />
        홈에서 다른 이야기를 살펴보세요.
      </p>
      <div class="status-buttons">
        <a class="button button-black" href={withBase('/')}>
          홈으로 <Icon />
        </a>
        <a class="button button-outline" href={withBase('/diagnosis/')}>
          상담 문의
        </a>
      </div>
    </div>
  </section>
</Layout>
