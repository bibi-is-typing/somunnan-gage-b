---
import { withBase } from '../utils/urls';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import cafe from '../assets/cafe-concept.png';
import LineIcon from '../components/LineIcon.astro';
import { industries, industryDetails, heroWorks, channels, portfolio, monthPlan, faqs } from '../data/site';
---

<Layout>
  <section
    data-review-id="S2"
    data-review-title="첫 화면"
    class="hero"
    aria-labelledby="hero-heading"
  >
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="hero-kicker">
          <span class="status-dot"></span>소상공인·전문직을 위한 마케팅
        </div>
        <h1 id="hero-heading">
          장사에 집중하세요.
          <br />
          <span class="lime">소문은</span>
          <br />
          <span class="hero-last">
            우리가 낼게요<em>.</em>
            <svg class="hero-spark" viewBox="0 0 70 70" aria-hidden="true">
              <path d="M35 0v70M0 35h70M10 10l50 50M10 60 60 10" />
            </svg>
          </span>
        </h1>
        <p class="hero-description">
          무엇을 올릴지 고민부터 촬영·제작·게시까지 맡기세요.
          <br class="desktop-break" /> 한 달 해보고 아니다 싶으면, 직접 운영할 수 있게 세팅해 드려요.
        </p>
        <div class="hero-buttons">
          <a href="#work" class="text-link v3-hero-link">
            작업물 보기 <span aria-hidden="true">↘</span>
          </a>
          <a href="#pricing" class="text-link v3-hero-link">
            한 달 운영 알아보기 <span aria-hidden="true">↘</span>
          </a>
        </div>
        <div class="v3-channels" aria-label="운영 채널">
          <span class="v3-channels-label">운영 채널</span>
          <ul>
            {channels.map((ch) => (
              <li class={`v6-ch v6-ch-${ch.id}`}>
                <span class="v6-ch-mark">
                  {ch.logo ? (
                    <img src={withBase(`/${ch.logo}`)} alt="" width="28" height="28" />
                  ) : (
                    <LineIcon name={ch.id} />
                  )}
                </span>
                {ch.label}
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="v3-showcase" aria-label="채널별 작업물">
        {heroWorks.map((work) => (
          <figure class:list={['v3-work', `v3-work-${work.shape}`, `v3-ch-${work.channel}`]}>
            <figcaption class="v3-work-chip">
              <LineIcon name={work.channel} />
              {work.channelLabel}
            </figcaption>
            <div class="v3-work-media">
              {work.image === 'cafe' ? (
                <Image
                  src={cafe}
                  alt="AI로 제작한 가상 카페 게시물 샘플"
                  width={520}
                  height={600}
                  format="webp"
                  loading="eager"
                  fetchpriority="high"
                />
              ) : work.image ? (
                <img src={withBase(`/${work.image}`)} alt={work.title.replace('\n', ' ')} loading="eager" />
              ) : (
                <div class="v3-placeholder" aria-hidden="true">
                  {work.channel === 'youtube' ? (
                    <span class="v3-play"><LineIcon name="play" /></span>
                  ) : (
                    <span class="v3-lines"><i></i><i></i><i></i></span>
                  )}
                </div>
              )}
              <div class="v3-work-title">
                {work.title.split('\n').map((line) => (
                  <span>{line}</span>
                ))}
              </div>
            </div>
            <span class="v3-work-status">{work.image === 'cafe' ? '자체 제작 샘플' : work.image ? '실제 작업물' : '실제 작업물 업로드 예정'}</span>
          </figure>
        ))}
      </div>
    </div>
    <div class="container hero-bottom">
      <span>가게마다 알릴 것도, 알리는 방법도 다르니까.</span>
      <a href="#industries">
        우리 업종 살펴보기 <span aria-hidden="true">↓</span>
      </a>
    </div>
  </section>

  <section
    data-review-id="S3"
    data-review-title="업종별 콘텐츠"
    id="industries"
    class="section section-dark industry-section"
    aria-labelledby="industry-heading"
  >
    <div class="container">
      <div class="section-heading" data-reveal>
        <div>
          <span class="eyebrow">
            <span>01</span> YOUR BUSINESS
          </span>
          <h2 id="industry-heading">
            손님이 궁금한 것부터
            <br />
            알려주세요.
          </h2>
        </div>
        <p>
          업종을 선택해보세요.
          <br />
          어떤 내용을 다룰 수 있는지 보여드릴게요.
        </p>
      </div>
      <div data-tabs class="industry-tabs">
        <div class="tab-list industry-tab-list" role="tablist" aria-label="업종별 운영 제안">
          {industries.map((item, i) => (
            <button
              role="tab"
              id={`tab-${item.id}`}
              aria-controls={`industry-${item.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {item.label}
              <span aria-hidden="true">↗</span>
            </button>
          ))}
        </div>
        {industries.map((item, i) => (
          <div
            class="industry-panel"
            role="tabpanel"
            id={`industry-${item.id}`}
            aria-labelledby={`tab-${item.id}`}
            hidden={i !== 0}
            tabindex="0"
          >
            <div class="industry-copy">
              <span class="subtle-label">{item.label}</span>
              <h3>
                {item.question.split('\n').map((line) => (
                  <span>{line}</span>
                ))}
              </h3>
              <p>{item.text}</p>
              <div class="tag-row">
                {item.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
            </div>
            <div class="industry-subjects">
              <span class="subtle-label">이런 내용을 담습니다</span>
              <ol>
                {item.subjects.map((subject, index) => (
                  <li>
                    <span>0{index + 1}</span>
                    <strong>{subject}</strong>
                  </li>
                ))}
              </ol>
              <span class="subjects-note">우리 가게에 맞는 소재를 상담에서 찾아보세요.</span>
            </div>
          </div>
        ))}
      </div>
      <div class="v3-detail" id="industry-detail">
        <div class="v3-detail-top" data-reveal>
          <div>
            <span class="subtle-label">업종별로 자세히</span>
            <h3>우리 업종은 이렇게 소문냅니다.</h3>
          </div>
          <div class="v3-filter" role="group" aria-label="업종 분류">
            <button type="button" aria-pressed="true" data-filter="all">전체</button>
            <button type="button" aria-pressed="false" data-filter="pro">전문직</button>
            <button type="button" aria-pressed="false" data-filter="shop">자영업</button>
          </div>
        </div>
        <div class="v3-grid">
          {industryDetails.map((item) => (
            <article class="v3-card" data-cat={item.cat}>
              <div class="v3-card-head">
                <span class="v3-card-icon"><LineIcon name={item.icon} /></span>
                <span class:list={['v3-cat', `v3-cat-${item.cat}`]}>{item.cat === 'pro' ? '전문직' : '자영업'}</span>
              </div>
              <h4>{item.title}</h4>
              <p class="v3-quote">“{item.quote}”</p>
              <span class="v3-how-label">소문난 가게가 하면</span>
              <ul class="v3-how">
                {item.how.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
              <div class="v3-card-ch">
                {item.channels.map((c) => (
                  <span>{c}</span>
                ))}
              </div>
              {item.rule && <p class="v3-rule">{item.rule}</p>}
            </article>
          ))}
        </div>
        <p class="v3-more">
          목록에 없는 업종도 운영할 수 있어요. 문의할 때 업종을 알려주세요.
        </p>
      </div>
    </div>
  </section>

  <section
    data-review-id="S4"
    data-review-title="작업물 모음"
    id="work"
    class="section section-light work-section"
    aria-labelledby="work-heading"
  >
    <div class="container">
      <div class="section-heading" data-reveal>
        <div>
          <span class="eyebrow">
            <span>02</span> PORTFOLIO
          </span>
          <h2 id="work-heading">
            작업물
            <br />
            모아보기.
          </h2>
        </div>
        <p>
          유튜브, 인스타그램, 블로그, 플레이스까지.
          <br />
          채널별 작업물을 계속 추가합니다.
        </p>
      </div>
      <div class="v3-portfolio">
        {portfolio.map((item) => (
          <figure class:list={['v3-pf', `v3-pf-${item.shape}`]} data-reveal>
            <div class="v3-pf-media">
              {item.image === 'cafe' ? (
                <Image src={cafe} alt="AI로 제작한 가상 카페 게시물 샘플" width={600} height={600} format="webp" loading="lazy" />
              ) : item.image ? (
                <img src={withBase(`/${item.image}`)} alt={item.channelLabel} loading="lazy" />
              ) : (
                <div class="v3-pf-empty" aria-hidden="true">
                  <LineIcon name={item.channel} />
                </div>
              )}
              {item.title && (
                <div class="v3-pf-title">
                  {item.title.split('\n').map((line) => (
                    <span>{line}</span>
                  ))}
                </div>
              )}
            </div>
            <figcaption>
              <span class="v3-pf-ch">
                <LineIcon name={item.channel} />
                {item.channelLabel}
              </span>
              <span class="v3-pf-status">
                {item.image === 'cafe' ? '자체 제작 샘플' : item.image ? '실제 작업물' : '업로드 예정'}
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section
    data-review-id="S10"
    data-review-title="한 달 운영과 요금"
    id="pricing"
    class="section section-light pricing-section"
    aria-labelledby="pricing-heading"
  >
    <div class="container">
      <div class="section-heading" data-reveal>
        <div>
          <span class="eyebrow">
            <span>03</span> ONE MONTH FIRST
          </span>
          <h2 id="pricing-heading">
            한 달만
            <br />
            맡겨보세요.
          </h2>
        </div>
        <p>
          아니다 싶으면, 사장님이 직접 운영할 수 있게{' '}
          <br />
          세팅하고 방법까지 알려드리고 마무리합니다.
        </p>
      </div>
      <div class="v3-plan">
        <article class="v3-plan-card" data-reveal>
          <span class="plan-kicker">첫 한 달 운영</span>
          <div class="v3-plan-price">{monthPlan.price}</div>
          <p class="v3-plan-terms">{monthPlan.terms}</p>
          <ul>
            {monthPlan.includes.map((item) => (
              <li>
                <Icon name="check" />
                {item}
              </li>
            ))}
          </ul>
        </article>
        <div class="v3-plan-flow">
          <ol class="v3-weeks" data-reveal>
            {monthPlan.weeks.map((w) => (
              <li>
                <span class="v3-week-label">{w.label}</span>
                <div>
                  <h3>{w.title}</h3>
                  <p>{w.text}</p>
                </div>
              </li>
            ))}
          </ol>
          <div class="v3-after" data-reveal>
            <span class="v3-after-label">한 달 뒤, 사장님이 고르세요</span>
            <div class="v3-after-grid">
              <div class="v3-after-card v3-after-keep">
                <span>A</span>
                <h3>계속 맡기기</h3>
                <p>반응이 좋으면 다음 달도 그대로 운영합니다. 보고서를 보고 채널과 작업량을 조정해요.</p>
              </div>
              <div class="v3-after-card">
                <span>B</span>
                <h3>직접 운영하기</h3>
                <p>계정 세팅, 게시 캘린더, 촬영·글쓰기 방법, 리뷰 답글 예시를 넘겨드리고 사용법을 알려드려요.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <p class="price-note">
        견적에서 확인할 항목: 운영 채널 수, 제작 수량, 촬영 여부, 광고비, 부가세
      </p>
    </div>
  </section>

  <section
    data-review-id="S11"
    data-review-title="자주 묻는 질문"
    id="faq"
    class="section section-light faq-section"
    aria-labelledby="faq-heading"
  >
    <div class="container faq-grid">
      <div data-reveal>
        <span class="eyebrow">
          <span>04</span> GOOD QUESTIONS
        </span>
        <h2 id="faq-heading">자주 묻는 질문</h2>
        <p>문의 전에 궁금한 내용을 확인해보세요.</p>
      </div>
      <div class="faq-list">
        {faqs.map((faq, i) => (
          <details class="faq-item" data-reveal>
            <summary>
              <span class="faq-number">0{i + 1}</span>
              {faq.question}
              <Icon name="plus" />
            </summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
