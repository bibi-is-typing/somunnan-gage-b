---
import { withBase } from '../utils/urls';
import Icon from './Icon.astro';
import { business } from '../data/site';
---

<footer data-review-id="S13" data-review-title="푸터" class="site-footer">
  <div class="container footer-top">
    <a class="brand" href={withBase('/')}>
      <span class="brand-symbol">
        <Icon name="megaphone" />
      </span>
      소문난 가게
    </a>
    <p>
      사장님은 장사에.
      <br />
      우리는 가게 홍보에.
    </p>
    <a href="#top" class="to-top">
      맨 위로 <span aria-hidden="true">↑</span>
    </a>
  </div>
  <div class="container footer-bottom v6-footer-bottom">
    <div class="v6-biz">
      <dl>
        <div><dt>상호명</dt><dd>{business.name}</dd></div>
        <div><dt>대표자</dt><dd>{business.ceo}</dd></div>
        <div><dt>사업자등록번호</dt><dd>{business.regNo}</dd></div>
        <div><dt>이메일</dt><dd><a href={`mailto:${business.email}`}>{business.email}</a></dd></div>
      </dl>
      <p class="v6-copy">
        © {new Date().getFullYear()} {business.name}. 소문난 가게는 {business.name}의 서비스입니다. ·{' '}
        <a href={withBase('/privacy/')}>개인정보 안내</a>
      </p>
    </div>
    <img class="v6-patera" src={withBase('/brand/patera-light.png')} alt="PATERA · Beyond Growth" width="600" height="158" />
  </div>
</footer>
