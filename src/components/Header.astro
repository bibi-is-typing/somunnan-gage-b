---
import { withBase } from '../utils/urls';
import Icon from './Icon.astro';
interface Props {
  simple?: boolean;
}
const { simple = false } = Astro.props;
---

<a class="skip-link" href="#main">
  본문으로 건너뛰기
</a>

<header data-review-id="S1" data-review-title="헤더와 메뉴" class="site-header" data-header>
  <div class="container nav-wrap">
    <a class="brand" href={withBase('/')} aria-label="소문난 가게 홈">
      <span class="brand-symbol">
        <Icon name="megaphone" />
      </span>
      <span>
        소문난 가게
      </span>
    </a>
    {simple ? (
      <a class="back-home" href={withBase('/')}>
        홈으로 <span aria-hidden="true">↗</span>
      </a>
    ) : (
      <>
        <nav class="desktop-nav" aria-label="주 메뉴">
          <a href={withBase('/#industries')}>업종별 사례</a>
          <a href={withBase('/#work')}>작업물</a>
          <a href={withBase('/#pricing')}>요금</a>
        </nav>
        <div class="header-actions">
          <a class="button button-small button-lime" href={withBase('/diagnosis/')}>
            상담 문의 <Icon />
          </a>
          <button
            class="menu-button"
            aria-label="메뉴 열기"
            aria-expanded="false"
            aria-controls="mobile-menu"
            data-menu-toggle
          >
            <span></span>
            <span></span>
          </button>
        </div>
        <nav id="mobile-menu" class="mobile-menu" aria-label="모바일 주 메뉴" hidden>
          <a href={withBase('/#industries')}>업종별 사례</a>
          <a href={withBase('/#work')}>작업물</a>
          <a href={withBase('/#pricing')}>요금</a>
          <a href={withBase('/#faq')}>자주 묻는 질문</a>
        </nav>
      </>
    )}
  </div>
</header>
